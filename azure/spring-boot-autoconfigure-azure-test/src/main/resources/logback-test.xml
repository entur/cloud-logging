<configuration>

    <include resource="logback/logback-spring-test.xml" />

    <appender name="STDOUT_ASYNC" class="no.entur.logging.cloud.logback.logstash.test.CompositeConsoleAsyncAppenderLogging">
        <discardingThreshold>0</discardingThreshold>
        <maxFlushTime>0</maxFlushTime>
        <!--
            Reserved/duplicate JSON field names fail the log statement. Switch this off at runtime with
            CompositeConsoleOutputControl.disableValidation(), preferably in a try-with-resources block.

            This is deliberately not a Spring property or part of this configuration, because logging is global
            state: there is a single logback configuration per JVM, which Spring Boot re-initializes, replacing
            these appenders, every time a new application context is created. A value bound to one context would
            therefore apply to whichever context was created last, including test classes which reuse a cached
            context but asked for something else. CompositeConsoleOutputControl is static and read for every
            log statement, so it is not affected.
        -->
        <validator class="no.entur.logging.cloud.azure.spring.test.AzureLogStatementFieldNameValidator"/>
        <appender-ref ref="STDOUT" />
    </appender>

    <root>
        <appender-ref ref="STDOUT_ASYNC" />
    </root>

</configuration>