<included>

	<!-- Spring Boot default logger levels, as without AI mode -->
	<include resource="logback/spring-defaults-test.xml" />

	<!-- both files -->
	<conversionRule conversionWord="aiLevel" class="no.entur.logging.cloud.logback.logstash.test.AiLevelConverter" />

	<!-- compact file -->
	<conversionRule conversionWord="cLogger" class="no.entur.logging.cloud.logback.logstash.test.CompactLoggerConverter" />
	<conversionRule conversionWord="cMdc" class="no.entur.logging.cloud.logback.logstash.test.CompactMdcConverter" />
	<conversionRule conversionWord="cEventId" class="no.entur.logging.cloud.logback.logstash.test.CompactEventIdConverter" />
	<conversionRule conversionWord="cMsg" class="no.entur.logging.cloud.logback.logstash.test.CompactMessageConverter" />
	<conversionRule conversionWord="cFields" class="no.entur.logging.cloud.logback.logstash.test.CompactFieldsConverter" />
	<conversionRule conversionWord="cEx" class="no.entur.logging.cloud.logback.logstash.test.SingleLineRootCauseFirstThrowableProxyConverter" />

	<!-- full file -->
	<conversionRule conversionWord="fMdc" class="no.entur.logging.cloud.logback.logstash.test.FullMdcConverter" />
	<conversionRule conversionWord="fEventId" class="no.entur.logging.cloud.logback.logstash.test.FullEventIdConverter" />
	<conversionRule conversionWord="fMsg" class="no.entur.logging.cloud.logback.logstash.test.FullMessageConverter" />
	<conversionRule conversionWord="fFields" class="no.entur.logging.cloud.logback.logstash.test.FullFieldsConverter" />
	<conversionRule conversionWord="fEx" class="no.entur.logging.cloud.logback.logstash.test.FullThrowableProxyConverter" />

	<!-- stop logging at JVM exit also without Spring Boot, so that queued events and pending "repeated N more times" lines are written -->
	<shutdownHook class="no.entur.logging.cloud.logback.logstash.test.AiShutdownHook" />

	<!--
		Compact plain text (one event per line) written to <file>.compact, where <file> is given by -Dentur.logging.ai.file (default: entur-logging-ai in the temp directory),
		nothing on the console. Included from logback-test.xml only if -Dentur.logging.ai.enabled=true.
	-->
	<appender name="AI_FILE" class="no.entur.logging.cloud.logback.logstash.test.AiFileAppender">
		<file>${entur.logging.ai.file:-${java.io.tmpdir}/entur-logging-ai}.compact</file>
		<!-- held by the test JVM which uses aliases, see AiFileAppender -->
		<lockFile>${entur.logging.ai.file:-${java.io.tmpdir}/entur-logging-ai}.lock</lockFile>
		<!-- framework start-up/shutdown chatter below WARN, override with -Dentur.logging.ai.quiet-loggers=a.b,c.d -->
		<filter class="no.entur.logging.cloud.logback.logstash.test.QuietLoggersFilter" />
		<!-- compact file level, override with -Dentur.logging.ai.level=DEBUG -->
		<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
			<level>${entur.logging.ai.level:-INFO}</level>
		</filter>
		<append>true</append>
		<immediateFlush>true</immediateFlush>
		<encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<!--
				compact plain text for AI: no timestamp, thread or colours, simple class names, shorter MDC;
				structured fields (Logstash markers, key-value pairs) as JSON, truncated like request-response bodies;
				stack traces on a single line (grep friendly), root-cause-first, framework frames removed, frames limited by entur.logging.ai.stacktrace.max-lines
			-->
			<pattern>%aiLevel %cLogger%cMdc%cEventId : %cMsg%cFields%cEx{full,org.springframework,org.junit,org.gradle,worker.org.gradle,org.apache,jakarta.,io.grpc,io.netty,io.micrometer,org.zalando.logbook,jdk.internal,jdk.proxy,java.lang.reflect,java.util,sun.reflect}%n%nopex</pattern>
			<charset>UTF-8</charset>
		</encoder>
	</appender>

	<!-- collapses repeated WARN/ERROR events in the compact file ("repeated N more times"); disable with -Dentur.logging.ai.dedupe=false -->
	<appender name="AI_DEDUP" class="no.entur.logging.cloud.logback.logstash.test.DeduplicatingAppender">
		<appender-ref ref="AI_FILE" />
	</appender>

	<!-- Drill-down: the same events unfiltered and untrimmed (all levels, full stack traces) in <file>.full -->
	<appender name="AI_FILE_FULL" class="no.entur.logging.cloud.logback.logstash.test.AiFileAppender">
		<file>${entur.logging.ai.file:-${java.io.tmpdir}/entur-logging-ai}.full</file>
		<lockFile>${entur.logging.ai.file:-${java.io.tmpdir}/entur-logging-ai}.lock</lockFile>
		<!-- override with -Dentur.logging.ai.full.level=INFO -->
		<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
			<level>${entur.logging.ai.full.level:-DEBUG}</level>
		</filter>
		<append>true</append>
		<immediateFlush>true</immediateFlush>
		<encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<pattern>%d{HH:mm:ss.SSS} %-5aiLevel [%thread] %logger%fMdc%fEventId : %fMsg%fFields%n%fEx</pattern>
			<charset>UTF-8</charset>
		</encoder>
	</appender>

	<!-- writes nothing; exposes the JSON encoder which LogStatements / LogbackTestExtension use to evaluate assertions -->
	<appender name="AI_ENCODER_ONLY" class="no.entur.logging.cloud.logback.logstash.test.NoopAppender">
		<encoder class="no.entur.logging.cloud.azure.logback.logstash.AzureLogstashEncoder">
			<providers>
				<timestamp>
					<fieldName>timestamp</fieldName>
					<timeZone>UTC</timeZone>
				</timestamp>
				<loggerName>
					<fieldName>logger</fieldName>
				</loggerName>
				<logLevel>
					<fieldName>level</fieldName>
				</logLevel>
				<threadName>
					<fieldName>thread</fieldName>
				</threadName>
				<nestedField>
					<fieldName>mdc</fieldName>
					<providers>
						<mdc />
					</providers>
				</nestedField>
				<stackTrace>
					<fieldName>stackTrace</fieldName>
					<throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
						<maxDepthPerThrowable>200</maxDepthPerThrowable>
						<maxLength>14000</maxLength>
						<rootCauseFirst>true</rootCauseFirst>
					</throwableConverter>
				</stackTrace>
				<logstashMarkers/>
				<message />
				<throwableClassName>
					<fieldName>exceptionClass</fieldName>
				</throwableClassName>
			</providers>
		</encoder>
	</appender>

	<!-- logback async appenders accept a single child, so fan out to both files and the encoder-only appender -->
	<appender name="AI_FANOUT" class="no.entur.logging.cloud.logback.logstash.test.FanOutAppender">
		<appender-ref ref="AI_DEDUP" />
		<appender-ref ref="AI_FILE_FULL" />
		<appender-ref ref="AI_ENCODER_ONLY" />
	</appender>

	<!--
		on-demand logging requires a LoggingScopeAsyncAppender; this subclass also lets LogbackTestExtension receive the events
		as they are written (after on-demand filtering and with the complete MDC), as with console output
	-->
	<appender name="AI_FILE_ASYNC" class="no.entur.logging.cloud.logback.logstash.test.CompositeConsoleAsyncAppenderLogging">
		<discardingThreshold>0</discardingThreshold>
		<maxFlushTime>0</maxFlushTime>
		<appender-ref ref="AI_FANOUT" />
	</appender>


	<root>
		<appender-ref ref="AI_FILE_ASYNC" />
	</root>

</included>
