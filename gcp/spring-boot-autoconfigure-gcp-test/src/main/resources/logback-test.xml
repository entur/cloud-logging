<configuration>

    <include resource="logback/logback-spring-test.xml" />

    <appender name="STDOUT_ASYNC" class="no.entur.logging.cloud.logback.logstash.test.CompositeConsoleAsyncAppenderLogging">
        <discardingThreshold>0</discardingThreshold>
        <maxFlushTime>0</maxFlushTime>
        <validator class="no.entur.logging.cloud.gcp.spring.test.GcpLogStatementFieldNameValidator">
            <!-- reserved/duplicate JSON field names fail the log statement; disable with -Dentur.logging.test.field-name-validation.enabled=false -->
            <enabled>${entur.logging.test.field-name-validation.enabled:-true}</enabled>
        </validator>
        <appender-ref ref="STDOUT" />
    </appender>

    <root>
        <appender-ref ref="STDOUT_ASYNC" />
    </root>

</configuration>